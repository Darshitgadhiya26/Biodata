# ---------------------------------------------------------------------------
# Copy this file to `.env` (local) and add the same keys in Vercel → Settings →
# Environment Variables (Production, Preview and Development).
#
# Only VITE_* variables are exposed to the browser. Everything below is safe to
# ship to the client: the anon key is a public, RLS-restricted key.
# NEVER put the Supabase service_role key in a VITE_* variable.
# ---------------------------------------------------------------------------

# Supabase project URL — Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — Project Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Canonical public URL of the deployed site. Used for the QR code, the canonical
# <link> tag and the share sheet. Optional in local dev (falls back to
# window.location.origin), but set it in Vercel so QR codes never point at
# localhost or at a preview deployment.
VITE_SITE_URL=https://your-project.vercel.app
