# ---------------------------------------------------------------------------
# Copy this file to `.env` for local development with `vercel dev`, and add the
# same keys in Vercel → Settings → Environment Variables (Production, Preview
# and Development).
#
# Every variable below is SERVER-SIDE ONLY. None of them is prefixed with
# VITE_, which is what keeps them out of the browser bundle: Vite only exposes
# VITE_* variables to client code. Never rename these with a VITE_ prefix, never
# put them in data/biodata.json, and never commit a real .env file.
# ---------------------------------------------------------------------------

# GitHub token used to commit data/biodata.json and profile photos.
# Fine-grained personal access token scoped to this repository with
# "Contents: Read and write". Classic tokens need the `repo` scope.
GITHUB_TOKEN=

# The account or organisation that owns the repository (the part before the /).
GITHUB_OWNER=

# The repository name (the part after the /).
GITHUB_REPO=

# Branch the site is deployed from, and therefore the branch commits go to.
GITHUB_BRANCH=main

# Password for /admin. Use a long, random passphrase — it is the only thing
# standing between the internet and your repository's contents.
ADMIN_PASSWORD=
