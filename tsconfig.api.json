{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "skipLibCheck": true,

    /* NodeNext mirrors how Vercel actually runs these files: each .ts is
       transpiled to an ESM .js in place, never bundled, so Node's loader
       resolves the relative imports itself and REQUIRES the .js extension.
       Using bundler resolution here is what hid that — it happily resolved
       extensionless specifiers that then failed at runtime. */
    "moduleResolution": "NodeNext",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node"]
  },
  "include": ["api"]
}
